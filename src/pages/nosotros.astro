---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Nosotros | Espacio Cultural">
  <section class="seccion nosotros">
    <div class="nosotros-texto">
      <h2>Sobre nosotros</h2>
      <p>
        Espacio Cultural es una organización que promueve el arte y la
        creatividad en nuestra comunidad.
      </p>
      <h3>Nuestro propósito</h3>
      <p>
        Queremos que cualquier persona tenga un lugar donde aprender, expresarse
        y compartir con otros a través de talleres de fotografía, cerámica,
        escritura creativa e ilustración.
      </p>
    </div>

    <img
      class="nosotros-imagen"
      src="src/img/YoYMiCompa.jpeg"
      alt="Personas participando en un taller de Espacio Cultural"
    />
  </section>
</Layout>
